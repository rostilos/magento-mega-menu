<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Rostilos_Base::content">
                    <resource id="Rostilos_MegaMenu::rsmegamenu_content" title="Rostilos Mega Menu" sortOrder="11" >
                        <resource id="Rostilos_MegaMenu::group" title="Manage Menu" sortOrder="1">
                            <resource id="Rostilos_MegaMenu::group_save" title="Save Menu" sortOrder="1" />
                            <resource id="Rostilos_MegaMenu::group_delete" title="Delete Menu" sortOrder="2" />
                            <resource id="Rostilos_MegaMenu::group_duplicate" title="Duplicate Menu" sortOrder="3" />
                        </resource>
                        <resource id="Rostilos_MegaMenu::item" title="Manage Menu Items" sortOrder="2">
                            <resource id="Rostilos_MegaMenu::item_save" title="Save Menu Item" sortOrder="1" />
                            <resource id="Rostilos_MegaMenu::item_delete" title="Delete Menu Item" sortOrder="2" />
                        </resource>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Rostilos_Base::settings">
                                <resource id="Rostilos_MegaMenu::settings" title="Rostilos MegaMenu Section" sortOrder="2" />
                            </resource>
                        </resource>
                    </resource>
                </resource>

            </resource>
        </resources>
    </acl>
</config>
