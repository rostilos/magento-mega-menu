<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
	<body>
        <referenceContainer name="head.additional">
            <block class="Magento\Framework\View\Element\Template"
                   name="ub_base_head"
                   template="Rostilos_Base::head.phtml" />
        </referenceContainer>
		<referenceContainer name="before.body.end">
			<block class="Magento\Backend\Block\Template" template="Rostilos_Base::before_body_end.phtml" />
		</referenceContainer>
		<referenceContainer name="root">
            <block ifconfig="rostilos_general/general/enable_ajax_wishlist"
                   class="Rostilos\Base\Block\Ajax\Wishlist" name="ub.ajax.wishlist"
				   as="rs-ajax-wishlist" template="Rostilos_Base::ajax/wishlist.phtml"/>
            <block ifconfig="rostilos_general/general/enable_ajax_add_cart"
                   class="Rostilos\Base\Block\Ajax\AddCart" name="ub.ajax.cart"
				   as="rs-ajax-cart" template="Rostilos_Base::ajax/add_cart.phtml"/>
		</referenceContainer>
    </body>
</page>
